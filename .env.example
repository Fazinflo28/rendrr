# ---- required ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rendrr
REDIS_URL=redis://localhost:6379
# Any S3-compatible store (Railway Bucket, Cloudflare R2, MinIO). Private bucket; everything is served by signed URLs.
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Clerk (dashboard → API keys). The MCP server needs both; the web app needs the publishable key.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# 32 random bytes, base64: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Shared by the API and the MCP server (any long random string)
INTERNAL_API_SECRET=
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_MCP_URL=http://localhost:4100
# Extra web origins allowed by the API (comma separated)
WEB_ORIGINS=

# ---- optional: each one switches a stub to the real thing ----
# TODO(key): AssemblyAI transcription. Unset = every video gets the sample transcript.
ASSEMBLYAI_API_KEY=
# TODO(key): Google Drive. Unset = a fake Drive with the built-in sample files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TODO(key): billing. Stripe is stubbed; every account is on the Studio plan.
STRIPE_SECRET_KEY=
# Limit sign ups to these emails (comma separated). Empty = anyone can sign up.
SIGNUP_ALLOWLIST=
