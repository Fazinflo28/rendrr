// Rendrr database. Field names follow the UI's fake `db` object where it has them.
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"] // rhel: Vercel Functions
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  email          String
  name           String   @default("")
  photoKey       String?  // storage key; the API returns a signed URL as `photo`
  logoKey        String?  // storage key; the API returns a signed URL as `logo`
  // Billing: plan trial (7 days, small allowance) | starter ($5 a month + pay as you go) | comp (granted, no limits).
  plan           String   @default("trial")
  planRenewsAt   DateTime @default(dbgenerated("(now() + interval '30 days')"))
  credits        Int      @default(0)
  storageLimitGB Float    @default(5)
  // trialing | active | past_due | canceled | expired (trial over, no plan)
  billingStatus  String   @default("trialing")
  trialEndsAt    DateTime @default(dbgenerated("(now() + interval '7 days')"))
  // The billing period now: the trial, a Stripe subscription period, or 30-day periods for a granted plan.
  periodStart    DateTime @default(now())
  periodEnd      DateTime @default(dbgenerated("(now() + interval '7 days')"))
  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  // The most pay-as-you-go usage a period may run up (cents), set by the user; 0: none beyond the plan.
  spendLimitCents Int     @default(2000)
  // Granted by an admin, used before pay as you go (this period and later until used).
  bonusExportMinutes  Float @default(0)
  bonusFootageMinutes Float @default(0)
  role           String   @default("user") // user | admin
  lastActiveAt   DateTime?
  billingNotes   Json     @default("{}") // alerts sent this period, the last payment error
  settings       Json     @default("{\"autoDelete\": true, \"theme\": \"system\"}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drive       DriveConnection?
  driveRemoved DriveRemoved[]
  videos      Video[]
  folders     Folder[]
  libraryFolders LibraryFolder[]
  projects    Project[]
  styles      Style[]
  references  Reference[]
  graphics    Graphic[]
  reviews     Review[]
  gallery     GalleryItem[]
  likes       GalleryLike[]
  usage       UsageEvent[]
  aiClients   AiConnection[]
  renders     Render[]
  chat        AiChatMessage[]
  notes       ProjectComment[]
  logins      UserLogin[]
  luts        Lut[]
  fonts       Font[]
  styleFiles  StyleFile[]
  sounds      Sound[]
  usageRecords UsageRecord[]
  invoices    BillingInvoice[]
}

// More logins that open the same Rendrr account: for example the Google account someone used for the AI connector
// when the website account was made with another one. The main login is User.clerkId.
model UserLogin {
  clerkId   String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model DriveConnection {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String
  refreshToken String   // AES-256-GCM encrypted, never logged
  scopes       String
  stub         Boolean  @default(false) // true when Google keys are not set: a fake Drive with sample files
  connectedAt  DateTime @default(now())
}

// A Google Drive video or folder the user deleted from the library: a folder sync does not bring it back. Picking the
// video again, or importing its folder again, does (and clears it).
model DriveRemoved {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String   // the Drive file or folder id
  createdAt DateTime @default(now())

  @@id([userId, itemId])
}

model Video {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  seconds          Float     @default(0)
  sizeBytes        BigInt    @default(0)
  orientation      String    @default("Landscape")
  fps              Float?
  width            Int?
  height           Int?
  hasAudio         Boolean   @default(true)
  kind             String    @default("footage") // footage | reference (a video whose style to copy)
  source           String    // drive | local
  sample           Boolean   @default(false) // built-in sample footage: original kept in our storage
  still            Boolean   @default(false) // an image (add_footage): kept as a still clip (STILL_SECONDS long) so it plays like any video
  driveFileId      String?
  originalName     String?
  originalSize     BigInt?
  sourceKey        String?   // storage key of an original we are allowed to keep (samples only)
  status           String    // linking | preview | previewing | uploading | paused | processing | ready | failed | missing | expired
  step             Int?
  progress         Int?
  error            String?
  art              String    @default("a")
  proxyKey         String?
  hdr              String?   // pq | hlg: the original is HDR (null: SDR or not known yet)
  timecode         String?   // Phase 22: start timecode HH:MM:SS:FF ("" = read, none; null = not read yet)
  audioKey         String?
  thumbKey         String?
  previewSizeBytes BigInt    @default(0)
  previewExpiresAt DateTime?
  // A folder in the library (videos of one kind kept together); null: loose in the library.
  libraryFolderId  String?
  libraryFolder    LibraryFolder? @relation(fields: [libraryFolderId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  analysis  FootageAnalysis?
  projects  Project[]
  originals TempOriginal[]

  @@index([userId, createdAt])
}

// A folder in the video library: videos of one kind kept together, sent to an edit all at once. Deleting it leaves its
// videos loose in the library.
model LibraryFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // The folder it is inside (a subfolder); null: at the top of the library. Deleting a folder moves what is in it up
  // a level in code; the database only clears the link.
  parentId  String?
  parent    LibraryFolder?  @relation("LibraryFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  LibraryFolder[] @relation("LibraryFolderTree")
  // Imported from a Google Drive folder: new videos put in that folder later come in too (synced on opening, by the
  // AI's tools and every few minutes). The top folder of an import holds the kind and whether subfolders come too.
  driveFolderId   String?
  driveId         String?   // a shared drive's id (for listing it)
  driveKind       String?   // footage | reference: what new videos come in as
  driveSubfolders Boolean   @default(true)
  driveSyncedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]

  @@index([userId])
  @@index([parentId])
  @@index([driveFolderId])
}

model FootageAnalysis {
  videoId     String   @id
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  transcriber String   // assemblyai | stub
  transcript  Json     // lines -> words { id, text, t, end, filler }
  silences    Json     @default("[]")
  sceneCuts   Json     @default("[]")
  keyFrames   Json     @default("[]") // [{ t, key }]
  musicBeats  Json?
  faces       Json?
  ocrText     Json?
  breakdown   Json?    // the video as text + contact sheets for the AI (shared/breakdown.ts)
  // The deeper measurements (shared/deep.ts): the sound every 10 ms (summary; frames in storage), where each word
  // starts and ends in the sound, and faces / motion / sharpness (summary; details in storage).
  audio       Json?
  alignment   Json?
  vision      Json?
  deepVersion Int?
  deepError   String?
  deepAt      DateTime?
  createdAt   DateTime @default(now())
}

model Folder {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  workspace String
  cover     Int       @default(1)
  members   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  reviews   Review[]

  @@index([userId])
}

model Project {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId       String
  folder         Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  videoId        String
  video          Video     @relation(fields: [videoId], references: [id], onDelete: Restrict)
  styleId        String? // the style apply_style applied; null: none (a new edit starts as the raw footage)
  reference      Json? // { kind: style | recipe | video, id, name }: attached for the user's AI to read, never applied
  name           String
  status         String    @default("Draft")
  aspect         String    @default("16:9")
  timeline       Json
  currentVersion Int       @default(1)
  outputSeconds  Float     @default(0) // length of the edited output, kept current by applyTimelineChange
  art            String    @default("a")
  sizeBytes      BigInt    @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions  ProjectVersion[]
  aiActions AiAction[]
  renders   Render[]
  chat      AiChatMessage[]
  notes     ProjectComment[]
  originals TempOriginal[]
  reviews   Review[]
  gallery   GalleryItem[]

  @@index([userId, updatedAt])
  @@index([folderId])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  v         Int
  note      String
  timeline  Json     // snapshot: { timeline, name, aspect, styleId }
  createdBy String   // user | claude | chatgpt | rendrr
  sealed    Boolean  @default(false) // rendered, shared or followed by an AI change: never edited in place again
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, v])
}

/// A timeline as it was before a change of timeline model (Phase 2: model A -> the sequence), to put back if needed.
model TimelineBackup {
  id        String   @id @default(cuid())
  projectId String
  version   Int?     // null: the project's working timeline; else that version's snapshot
  model     String   // the model it was stored in ("A")
  timeline  Json
  createdAt DateTime @default(now())

  @@index([projectId])
}

model AiAction {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  ai            String   // display name: Claude, ChatGPT, Rendrr
  text          String
  toolName      String
  input         Json
  via           String?  // "chat" = asked in the editor's AI chat (shown there as chat messages, not as connector activity)
  beforeVersion Int
  afterVersion  Int
  undone        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model Style {
  id          String   @id
  ownerId     String?  // null = built in
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  type        String
  vibe        String
  ori         String[]
  platforms   String[]
  captionLook String
  cutPace     String
  captionRule String
  zoomRules   String
  musicVibe   String
  rules       Json
  art         String
  sortOrder   Int      @default(0)
  sourceVideoId String? // a style an AI saved from a reference video: that video's id
  createdAt   DateTime @default(now())
}

model Reference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  recipe    Json
  keyFrames Json     @default("[]")
  createdAt DateTime @default(now())
}

model Graphic {
  id           String   @id @default(cuid())
  ownerId      String?  // null = built-in template
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  kind         String   // template | custom
  paramsSchema Json     @default("{}")
  code         String?  // custom only
  renderedKey  String?
  checkFrames  Json     @default("[]")
  durationSec  Float
  width        Int      @default(1080)
  height       Int      @default(1920)
  transparent  Boolean  @default(true)
  status       String   @default("ready") // queued | rendering | ready | failed
  error        String?
  /// Things the recording noticed that the AI should know (a font that was not there, drawn with a fallback).
  warnings     Json     @default("[]")
  attempts     Int      @default(0)
  /// When its code or a recording of it was last replaced (create_graphic replace, rerecord, retry_graphic): a
  /// preview made before it is out of date even though the edit did not change.
  changedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
}

model Render {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    // preview | final
  version    Int
  by         String    @default("user") // who asked: user | claude | chatgpt | gallery (a published edit with nothing to play)
  status     String    @default("queued") // queued | running | done | failed
  steps      Json      @default("[]")
  step       Int       @default(0)
  progress   Int       @default(0)
  outputKey  String?
  framesKeys Json      @default("[]")
  sizeBytes  BigInt    @default(0)
  seconds    Float     @default(0)
  quality    String?
  error      String?
  errorCode  String?
  plan       Json?
  driveSave  Json?     // a copy into the user's Google Drive: { state, folderId, path, name, fileId, link, error, ... }
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([userId, kind])
}

model TempOriginal {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  key       String
  uploadId  String?
  sizeBytes BigInt
  completed Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Review {
  token         String          @id
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  version       Int             @default(1)
  passwordHash  String?
  expiresAt     DateTime?
  expiresLabel  String          @default("No expiry")
  allowDownload Boolean         @default(false)
  showLogo      Boolean         @default(true)
  views         Int             @default(0)
  approved      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  comments      ReviewComment[]

  @@index([userId])
}

model ReviewComment {
  id          String   @id @default(cuid())
  reviewToken String
  review      Review   @relation(fields: [reviewToken], references: [token], onDelete: Cascade)
  projectId   String?
  time        Float    @default(0)
  text        String
  author      String   @default("Client")
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([reviewToken])
  @@index([projectId])
}

model GalleryItem {
  id            String        @id @default(cuid())
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  author        String
  title         String
  styleId       String
  ori           String
  platforms     String[]
  likes         Int           @default(0)
  views         Int           @default(0)
  recreates     Int           @default(0)
  allowRecreate Boolean       @default(true)
  recipe        Json          @default("{}")
  videoKey      String? // its own copy of the export it shows (gallery/<id>.mp4), made when published
  posterKey     String? // a still from it
  seconds       Float?
  createdAt     DateTime      @default(now())
  likedBy       GalleryLike[]
}

model GalleryLike {
  galleryItemId String
  item          GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([galleryItemId, userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // render_preview | render_final | video_edited | job
  amount    Float    @default(0) // minutes for renders
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model JobLog {
  id         String   @id @default(cuid())
  userId     String?
  queue      String
  jobId      String
  name       String
  event      String   // start | finish | fail
  durationMs Int?
  error      String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([queue, createdAt])
}

model AiConnection {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     String    // claude | chatgpt | other
  clientName String    @default("")
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, client])
}

// The AI chat inside an edit (editor > AI tab): what the user asked, what the AI replied, and the steps it ran.
model AiChatMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // user | ai
  ai        String?  // who answered: "Claude", or "Rendrr" for notices
  text      String
  workflow  Json     @default("[]")
  changed   Boolean  @default(false) // the AI changed the edit while answering
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// Notes left inside the editor at a moment of the video (client comments live on reviews).
model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  time      Float    @default(0)
  text      String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  // The Rendrr app in the chat: the preview it was made on, a drawing on the picture ({ w, h, strokes, key }: strokes
  // in 0-1 of the picture, key a PNG of them), pictures added to it ([{ key, w, h, name }]), when its text was edited.
  renderId  String?
  drawing   Json?
  images    Json?
  editedAt  DateTime?

  @@index([projectId])
}

// Colour LUTs the user imported (.cube, Phase 6). The file sits in storage; grades refer to it by id.
/// A font file the user added once (add_font, Settings), used by its family name in graphics.
model Font {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String
  weight    Int      @default(400)
  style     String   @default("normal") // normal | italic
  format    String   // ttf | otf | woff | woff2
  key       String   // storage key of the file
  size      Int
  createdAt DateTime @default(now())

  @@unique([userId, family, weight, style])
}

model Lut {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  key       String   // storage key of the .cube file
  kind      String   // 3d | 1d
  size      Int
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Engine Part 4.4: a reference video measured into a style file (analyze_reference), for the AI only: never shown in
/// the user interface. status: measuring | ready | failed; data: the StyleFile (packages/shared/src/styleFile.ts).
model StyleFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  name      String
  status    String   @default("measuring")
  progress  Int      @default(0)
  error     String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// The user's own audio files (add_audio): a voice made better outside Rendrr, their own music. Kept as AAC 48 kHz.
model Sound {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  key       String   @default("") // sounds/<userId>/<id>.m4a once made
  status    String   @default("processing") // processing | ready | failed
  error     String?
  seconds   Float    @default(0)
  sizeBytes BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------- billing and cost ----------------

// What a user is billed on: one row per thing used. Export and preview minutes per render, footage minutes per video
// (once, however often it is processed again), storage GB per user per day. billable = quantity x its multiplier
// (4K and heavy effects count double). One row per (metric, refId): a retried job never bills twice.
model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    String   // export | preview | footage | storage
  quantity  Float    // minutes (storage: GB that day)
  billable  Float    // what counts against the plan (minutes x multiplier; storage: GB)
  refId     String   // render id, video id, or "<userId>:<day>" for storage
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([metric, refId])
  @@index([userId, createdAt])
  @@index([metric, createdAt])
}

// What one job cost us, measured: CPU and memory of the worker container shared among the jobs running at the time,
// seconds sent to transcription, bytes sent out of Railway, at the rates in packages/shared/src/billing.ts.
// queue "idle": the worker's own use while no job ran (one row an hour, no user).
model JobCost {
  id               String   @id @default(cuid())
  userId           String?
  queue            String
  jobId            String
  kind             String   // render_preview | render_final | proxy | analyze | deep | graphic | frames | heard | ... | idle
  refId            String?  // render id or video id
  ok               Boolean  @default(true)
  wallMs           Int      @default(0)
  cpuSeconds       Float    @default(0)
  memGbSeconds     Float    @default(0)
  transcribeSeconds Float   @default(0)
  egressBytes      BigInt   @default(0)
  outputBytes      BigInt   @default(0)
  costCompute      Float    @default(0) // USD
  costMemory       Float    @default(0)
  costTranscribe   Float    @default(0)
  costEgress       Float    @default(0)
  costTotal        Float    @default(0)
  measured         String   @default("cgroup") // cgroup | process (the container's counters were not readable)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([queue, createdAt])
}

// Storage per user per day (bytes by kind), for the storage bill, the admin panel and the storage cost.
model StorageSnapshot {
  id        String   @id @default(cuid())
  userId    String
  day       String   // YYYY-MM-DD (UTC)
  bytes     BigInt
  byKind    Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

// A bill: a Stripe invoice mirrored here (status, totals, link), with the usage lines Rendrr added to it.
model BillingInvoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?  @unique
  number          String?
  periodStart     DateTime
  periodEnd       DateTime
  baseCents       Int      @default(0)
  usageCents      Int      @default(0)
  totalCents      Int      @default(0)
  status          String   @default("draft") // draft | open | paid | void | uncollectible | failed
  usageAdded      Boolean  @default(false)
  lines           Json     @default("[]")
  hostedUrl       String?
  pdfUrl          String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// A front-end error seen in someone's browser, grouped by fingerprint (message + first stack line + page).
model ClientError {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  message     String
  stack       String?
  url         String?
  userAgent   String?
  userId      String?
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([lastSeen])
}

// What an admin changed (plan, trial, bonus minutes, limit), and on whose account.
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  targetId   String?
  action     String
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetId, createdAt])
}

// A Stripe event handled (its id), so a resent webhook is not applied twice.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
