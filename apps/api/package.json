{
  "name": "@rendrr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "vercel-build": "pnpm --filter @rendrr/db exec prisma generate && pnpm --filter @rendrr/db exec prisma migrate deploy && pnpm --filter @rendrr/db exec tsx src/seed.ts && node vercel-build.mjs",
    "test": "tsx --env-file-if-exists=../../.env --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.0",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "10.3.0",
    "@rendrr/core": "workspace:*",
    "@rendrr/db": "workspace:*",
    "@rendrr/shared": "workspace:*",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
